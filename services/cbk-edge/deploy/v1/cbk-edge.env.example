# Copy to /etc/cbk-edge/cbk-edge.env and edit there. This example holds no
# secrets; keep the real file out of the repository and out of shell history.
#
# Leave PLAY_STORE_URL empty or unset until the public Google Play listing
# exists. While it is empty the site shows an honest "Google Play release in
# progress" panel instead of a download button. Any value here must be an
# HTTPS play.google.com/store/apps/details URL; the app package is forced to
# com.sarbaa.cbk and any other value is ignored.
#PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.sarbaa.cbk

# Optional real Android signing-certificate SHA-256 fingerprint for the release
# key, with or without colon separators. Read the value from the signing key you
# actually ship (`keytool -list -v`), never from the debug key. Until this holds
# a valid value, https://cbk.sarbaa.com/.well-known/assetlinks.json answers []
# and the App Link is unverified; a malformed or placeholder value is ignored the
# same way. It is not a secret, but it is deployment-specific: never commit a
# real value.
#ANDROID_SHA256_CERT_FINGERPRINT=

# The Bun adapter has no analytics storage binding, so the telemetry route
# answers 503 telemetry_unavailable and the Android app keeps its local queue.
# Nothing needs to be configured for this route; the line is here so the
# limitation is not mistaken for a missing secret.
# TELEMETRY_UNAVAILABLE=503
